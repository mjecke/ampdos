10 REM BASTEST.BAS - every BASIC keyword, the maths above all
20 REM BASIC BASTEST.  About 5 min.  Each check: ok or FAIL.
30 CLEAR 1000:P=0:F=0:T=1E-5:Q=4*ATN(1)
40 PRINT "ampDOS BASIC test":PRINT FRE(0);"bytes free"
50 GOTO 100
60 REM checks: N$ name, V value, E wanted, T relative tolerance
100 PRINT:PRINT "--- operators"
110 N$="2+3*4-6/3":V=2+3*4-6/3:E=12:GOSUB 9000
120 N$="(1+2)*(3+4)":V=(1+2)*(3+4):E=21:GOSUB 9000
130 N$="-7/2":V=-7/2:E=-3.5:GOSUB 9000
140 N$="2^10":V=2^10:E=1024:GOSUB 9000
150 N$="10^-3":V=10^-3:E=.001:GOSUB 9000
160 N$="1E10*1E-10":V=1E10*1E-10:E=1:GOSUB 9000
170 N$="65535+1":V=65535+1:E=65536:GOSUB 9000
180 N$="1/3*3":V=1/3*3:E=1:GOSUB 9000
190 N$="5>3, 5<3":V=(5>3)*10+(5<3):E=-10:GOSUB 9000
200 N$="4<=4 AND 4>=5":V=(4<=4)AND(4>=5):E=0:GOSUB 9000
210 N$="3<>3 OR 2=2":V=(3<>3)OR(2=2):E=-1:GOSUB 9000
220 N$="NOT 0":V=NOT 0:E=-1:GOSUB 9000
230 N$="12 AND 10":V=12 AND 10:E=8:GOSUB 9000
240 N$="12 OR 3":V=12 OR 3:E=15:GOSUB 9000
250 N$="&HFF+&B101":V=&HFF+&B101:E=260:GOSUB 9000
260 LET N$="LET":LET V=7:E=7:GOSUB 9000
300 PRINT "--- functions"
310 N$="ABS(-3.5)":V=ABS(-3.5):E=3.5:GOSUB 9000
320 N$="SGN -2,0,5":V=SGN(-2)*100+SGN(0)*10+SGN(5):E=-99:GOSUB 9000
330 N$="INT(-2.5)":V=INT(-2.5):E=-3:GOSUB 9000
340 N$="INT(2.7)":V=INT(2.7):E=2:GOSUB 9000
350 N$="SQR(2)":V=SQR(2):E=1.41421356:GOSUB 9000
360 N$="SQR(144)":V=SQR(144):E=12:GOSUB 9000
370 N$="LOG(10)":V=LOG(10):E=2.30258509:GOSUB 9000
380 N$="LOG(1)":V=LOG(1):E=0:GOSUB 9000
390 N$="EXP(1)":V=EXP(1):E=2.71828183:GOSUB 9000
400 N$="EXP(-2)":V=EXP(-2):E=.135335283:GOSUB 9000
410 N$="4*ATN(1)":V=Q:E=3.14159265:GOSUB 9000
420 N$="SIN(PI/6)":V=SIN(Q/6):E=.5:GOSUB 9000
430 N$="COS(PI/3)":V=COS(Q/3):E=.5:GOSUB 9000
440 N$="TAN(PI/4)":V=TAN(Q/4):E=1:GOSUB 9000
450 N$="SIN(0)+COS(0)":V=SIN(0)+COS(0):E=1:GOSUB 9000
460 N$="SIN(-1)":V=SIN(-1):E=-.841470985:GOSUB 9000
470 N$="ATN(-.5)":V=ATN(-.5):E=-.463647609:GOSUB 9000
480 N$="2^.5":V=2^.5:E=1.41421356:GOSUB 9000
490 DEF FNA(X)=X*X+1:N$="DEF FNA(3)":V=FNA(3):E=10:GOSUB 9000
500 V=RND(-5):A=RND(1):V=RND(-5):B=RND(1):N$="RND(-5) repeats"
510 V=A-B:E=0:GOSUB 9000
520 N$="RND(0) = last":V=RND(0)-B:E=0:GOSUB 9000
530 M=1:W=0:FOR I=1 TO 100:X=RND(1):IF X<M THEN M=X
540 IF X>W THEN W=X
550 NEXT:N$="RND(1) in 0..1":V=(M>=0)AND(W<1):E=-1:GOSUB 9000
600 PRINT "--- numbers read (program text and VAL)"
610 N$="123":V=123:E=100+23:GOSUB 9000
620 N$="65535":V=65535:E=65534+1:GOSUB 9000
630 N$="65536":V=65536:E=65535+1:GOSUB 9000
640 N$="0 and 00012":V=0+00012:E=12:GOSUB 9000
650 N$="3.25E2":V=3.25E2:E=325:GOSUB 9000
660 N$="VAL(12345)":V=VAL("12345"):E=12345:GOSUB 9000
670 N$="VAL(-7.5E3)":V=VAL("-7.5E3"):E=-7500:GOSUB 9000
680 N$="VAL(.25)":V=VAL(".25"):E=.25:GOSUB 9000
690 N$="VAL(1 2 3)":V=VAL(" 1 2 3"):E=123:GOSUB 9000
700 N$="VAL(ABC)":V=VAL("ABC"):E=0:GOSUB 9000
710 N$="VAL(STR$(I)) 0..3000":M=0:T=0
720 FOR I=0 TO 3000 STEP 7:IF VAL(STR$(I))<>I THEN M=M+1
730 NEXT:V=M:E=0:GOSUB 9000:T=1E-5
800 PRINT "--- strings"
810 N$="LEN":V=LEN("HELLO"):E=5:GOSUB 9000
820 N$="LEFT$":R$=LEFT$("HELLO",2):W$="HE":GOSUB 9100
830 N$="RIGHT$":R$=RIGHT$("HELLO",3):W$="LLO":GOSUB 9100
840 N$="MID$ 3":R$=MID$("HELLO",2,3):W$="ELL":GOSUB 9100
850 N$="MID$ 2":R$=MID$("HELLO",3):W$="LLO":GOSUB 9100
860 N$="CHR$, ASC":R$=CHR$(ASC("A")+1):W$="B":GOSUB 9100
870 N$="STR$(42)":R$=STR$(42):W$=" 42":GOSUB 9100
880 N$="STR$(-1.5)":R$=STR$(-1.5):W$="-1.5":GOSUB 9100
890 N$="HEX$(255)":R$=HEX$(255):W$="FF":GOSUB 9100
900 N$="BIN$(5)":R$=BIN$(5):W$="101":GOSUB 9100
910 N$="+ and <":R$="AB"+"CD":W$="ABCD":GOSUB 9100
920 N$="ABC<ABD":V="ABC"<"ABD":E=-1:GOSUB 9000
930 N$="@ and _ typed":R$="@_":W$=CHR$(64)+CHR$(95):GOSUB 9100
940 N$="strings, 400 more":R$="":FOR I=1 TO 400
950 R$=R$+CHR$(65+I-INT(I/26)*26):IF LEN(R$)>60 THEN R$=MID$(R$,30)
960 NEXT:V=LEN(R$):E=52:GOSUB 9000
970 N$="FRE()":V=FRE("")>0:E=-1:GOSUB 9000
1000 PRINT "--- statements"
1010 C=0:FOR I=10 TO 1 STEP -3:C=C+1:NEXT I:N$="FOR STEP -3"
1020 V=C:E=4:GOSUB 9000
1030 C=0:FOR I=0 TO 5 STEP .5:FOR J=1 TO 3:C=C+1:NEXT J,I
1040 N$="FOR .5, nested":V=C:E=33:GOSUB 9000
1050 K=0:ON 3 GOSUB 7100,7200,7300:N$="ON GOSUB":V=K:E=3:GOSUB 9000
1060 ON 2 GOTO 1070,1080,1070
1070 N$="ON GOTO":V=0:E=1:GOSUB 9000:GOTO 1090
1080 N$="ON GOTO":V=1:E=1:GOSUB 9000
1090 L=0:GOSUB 7400:N$="GOSUB 20 deep":V=L:E=20:GOSUB 9000
1100 READ A,B,R$:N$="READ DATA":V=A+B:E=4.5:GOSUB 9000
1110 RESTORE:READ A:N$="RESTORE":V=A:E=1.25:GOSUB 9000
1120 DIM G(20,20),H$(10):S=0:FOR I=0 TO 20:FOR J=0 TO 20
1130 G(I,J)=I*J:NEXT J,I:FOR I=0 TO 20:S=S+G(I,20-I):NEXT
1140 N$="DIM 2 dimensions":V=S:E=1330:GOSUB 9000
1150 FOR I=1 TO 10:H$(I)=STR$(I*I):NEXT:N$="string array"
1160 R$=H$(7)+H$(10):W$=" 49 100":GOSUB 9100
1170 IF 1>2 THEN 1190
1180 N$="IF THEN line":V=1:E=1:GOSUB 9000:GOTO 1200
1190 N$="IF THEN line":V=0:E=1:GOSUB 9000
1200 PRINT TAB(10);:X=POS(0):PRINT:N$="TAB, POS":V=X:E=10:GOSUB 9000
1210 PRINT "SPC(5)";SPC(5);"|5 spaces between"
1220 ? "? is PRINT":WIDTH 80:WIDTH 255:LINES 20
1230 N$="INP(41) the ID jumpers":V=INP(41):E=V:GOSUB 9000
1240 OUT 3,0:WAIT 132,4:N$="OUT 3,0; WAIT 132,4 (back)":V=1:E=1
1250 GOSUB 9000
1260 PRINT "SLEEP 1000: one second ...":SLEEP 1000
1270 STPRINT "STPRINT: this goes out of Serial B only"
1280 DPRINT "DPRINT: on the screen and out of Serial B"
1290 PRINT "DOS ";CHR$(34);"DIR";CHR$(34);":":DOS "DIR"
1300 REM PEEK POKE DEEK DOKE USR take -32768..32767: an address
1310 REM above 7FFFh is minus 65536.  WRKSPC+6: OUT (n),A, RET, SUB
1320 W=0:FOR A=-26624 TO -20481:IF PEEK(A)<>211 THEN 1340
1330 IF PEEK(A+2)=201 AND PEEK(A+3)=214 AND PEEK(A-3)=195 THEN W=A-6
1340 NEXT:N$="workspace found":V=W<0:E=-1:GOSUB 9000
1350 IF W=0 THEN 2000
1360 PRINT "WRKSPC at ";HEX$(W);"h, ";
1370 Z=INT((DEEK(W+218)+DEEK(W+90))/2):PRINT "scratch ";HEX$(Z);"h"
1380 POKE Z+1,123:N$="POKE PEEK":V=PEEK(Z+1):E=123:GOSUB 9000
1390 DOKE Z+2,12345:N$="DOKE DEEK":V=DEEK(Z+2):E=12345:GOSUB 9000
1400 POKE Z,201:U=DEEK(W+4):DOKE W+4,Z:V=USR(7.5):DOKE W+4,U
1410 N$="USR (a RET)":E=7.5:GOSUB 9000
2000 PRINT "--- identities over many values (max error)"
2010 M=0:FOR I=1 TO 300:X=I/11-13:S=SIN(X):C=COS(X)
2020 D=ABS(S*S+C*C-1):IF D>M THEN M=D
2030 NEXT:N$="SIN^2+COS^2=1":V=M:E=0:GOSUB 9000
2040 M=0:FOR I=1 TO 300:X=I*I/97+.001:D=ABS(EXP(LOG(X))/X-1)
2050 IF D>M THEN M=D
2060 NEXT:N$="EXP(LOG(X))=X":V=M:E=0:GOSUB 9000
2070 M=0:FOR I=1 TO 300:X=I*13.7:D=ABS(SQR(X)*SQR(X)/X-1)
2080 IF D>M THEN M=D
2090 NEXT:N$="SQR(X)^2=X":V=M:E=0:GOSUB 9000
2100 M=0:FOR I=-150 TO 150:X=I/101:D=ABS(ATN(TAN(X))-X)
2110 IF D>M THEN M=D
2120 NEXT:N$="ATN(TAN(X))=X":V=M:E=0:GOSUB 9000
2130 M=0:FOR I=1 TO 300:X=RND(1)*1E4-5E3:Y=RND(1)*99+.01
2140 D=ABS(X*Y/Y-X)/(ABS(X)+1E-9):IF D>M THEN M=D
2150 NEXT:N$="X*Y/Y=X":V=M:E=0:GOSUB 9000
2160 M=0:FOR I=1 TO 300:X=RND(1)*100+.1:Y=RND(1)*100+.1
2170 D=ABS(LOG(X*Y)-LOG(X)-LOG(Y)):IF D>M THEN M=D
2180 NEXT:N$="LOG(XY)=LOG X+LOG Y":V=M:E=0:GOSUB 9000
2190 M=0:FOR I=0 TO 24:D=ABS(2^I/(INT(2^I+.5))-1):IF D>M THEN M=D
2200 NEXT:N$="2^I, I=0..24":V=M:E=0:GOSUB 9000
2210 M=0:FOR I=1 TO 300:X=RND(1)*2000-1000
2220 IF INT(X)>X OR INT(X)+1<=X THEN M=M+1
2230 NEXT:N$="INT(X)<=X<INT(X)+1":V=M:E=0:GOSUB 9000
2240 M=0:FOR I=1 TO 1000:X=I*3+1:IF (X-1)/3<>I THEN M=M+1
2250 NEXT:N$="whole numbers exact":V=M:E=0:GOSUB 9000
3000 PRINT:PRINT P;"passed,";F;"failed"
3010 PRINT "Now STOP: type CONT and Return to go on."
3020 STOP
3030 INPUT "INPUT: type 42 and Return";A
3040 N$="INPUT":V=A:E=42:GOSUB 9000
3050 PRINT "By hand: LOAD, SAVE, SSAVE, SLOAD, LIST, NEW, RUN, DOS"
3060 PRINT "Done:";P;"passed,";F;"failed"
3070 END
7100 K=1:RETURN
7200 K=2:RETURN
7300 K=3:RETURN
7400 L=L+1:IF L<20 THEN GOSUB 7400
7410 RETURN
8000 DATA 1.25,3.25,WORD
9000 D=ABS(V-E):IF E<>0 THEN D=D/ABS(E)
9010 IF D<=T THEN P=P+1:PRINT "ok   ";N$;V:RETURN
9020 F=F+1:PRINT "FAIL ";N$;V;"want";E:RETURN
9100 IF R$=W$ THEN P=P+1:PRINT "ok   ";N$;" [";R$;"]":RETURN
9110 F=F+1:PRINT "FAIL ";N$;" [";R$;"] want [";W$;"]":RETURN
