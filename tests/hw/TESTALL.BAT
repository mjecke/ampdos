IF NOT ERRORLEVEL 1 TOUCH \FAILS\F61.TXT
REM ATTRIB: read-only and hidden
COPY \W7\U\L.TXT \W7\U\RO.TXT
ATTRIB +R \W7\U\RO.TXT
