@ECHO OFF
REM BUILD.BAT - assemble the utilities from the sources on this disk.
REM Boot the ampDOS disk in A:, put this one in B:, then  B:  and  BUILD.
REM CMP compares each new one with the one on A: (the same bytes, unless a
REM source was changed).
B:
ECHO SETUP
A:\BIN\ASM PROGRAMS\SETUP.ASM NEW\SETUP.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO DISKED
A:\BIN\ASM PROGRAMS\DISKED.ASM NEW\DISKED.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO ATTRIB
A:\BIN\ASM PROGRAMS\ATTRIB.ASM NEW\ATTRIB.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO TREE
A:\BIN\ASM PROGRAMS\TREE.ASM NEW\TREE.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO XCOPY
A:\BIN\ASM PROGRAMS\XCOPY.ASM NEW\XCOPY.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO UNDELETE
A:\BIN\ASM PROGRAMS\UNDELETE.ASM NEW\UNDELETE.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO HEAD
A:\BIN\ASM PROGRAMS\HEAD.ASM NEW\HEAD.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO TAIL
A:\BIN\ASM PROGRAMS\TAIL.ASM NEW\TAIL.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO TR
A:\BIN\ASM PROGRAMS\TR.ASM NEW\TR.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO DIFF
A:\BIN\ASM PROGRAMS\DIFF.ASM NEW\DIFF.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO DISKCOMP
A:\BIN\ASM PROGRAMS\DISKCOMP.ASM NEW\DISKCOMP.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO DUMP
A:\BIN\ASM PROGRAMS\DUMP.ASM NEW\DUMP.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO HEXED
A:\BIN\ASM PROGRAMS\HEXED.ASM NEW\HEXED.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO DEFRAG
A:\BIN\ASM PROGRAMS\DEFRAG.ASM NEW\DEFRAG.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO SCANDISK
A:\BIN\ASM PROGRAMS\SCANDISK.ASM NEW\SCANDISK.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO MEMMAP
A:\BIN\ASM PROGRAMS\MEMMAP.ASM NEW\MEMMAP.BIN
IF ERRORLEVEL 1 GOTO FAIL
ECHO ASCII
A:\BIN\ASM PROGRAMS\ASCII.ASM NEW\ASCII.BIN
IF ERRORLEVEL 1 GOTO FAIL
CMP NEW\SETUP.BIN A:\SETUP.BIN
CMP NEW\DISKED.BIN A:\BIN\DISKED.BIN
CMP NEW\ATTRIB.BIN A:\BIN\ATTRIB.BIN
CMP NEW\TREE.BIN A:\BIN\TREE.BIN
CMP NEW\XCOPY.BIN A:\BIN\XCOPY.BIN
CMP NEW\UNDELETE.BIN A:\BIN\UNDELETE.BIN
CMP NEW\HEAD.BIN A:\BIN\HEAD.BIN
CMP NEW\TAIL.BIN A:\BIN\TAIL.BIN
CMP NEW\TR.BIN A:\BIN\TR.BIN
CMP NEW\DIFF.BIN A:\BIN\DIFF.BIN
CMP NEW\DISKCOMP.BIN A:\BIN\DISKCOMP.BIN
CMP NEW\DUMP.BIN A:\BIN\DUMP.BIN
CMP NEW\HEXED.BIN A:\BIN\HEXED.BIN
CMP NEW\DEFRAG.BIN A:\BIN\DEFRAG.BIN
CMP NEW\SCANDISK.BIN A:\BIN\SCANDISK.BIN
CMP NEW\MEMMAP.BIN A:\BIN\MEMMAP.BIN
CMP NEW\ASCII.BIN A:\BIN\ASCII.BIN
GOTO END
:FAIL
ECHO The build failed.
:END
